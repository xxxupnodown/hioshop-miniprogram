.express-container {
  padding-top: 10rpx;
  margin: 0;
  width: 100%;
  height: 100vh;
  background-color: #f0f8ff;
  font-family: "Arial", "Microsoft YaHei", "黑体", "宋体", sans-serif;
}
.express-top {
  background-color: #ffffff;
  margin: 30rpx;
  padding: 50rpx;
  border-radius: 20rpx;
  box-shadow: 0px 0px 5px #f3f3f3;
}
.express-address:nth-of-type(1) {
  margin-bottom: 20rpx;
}
.express-address::before {
  background-image: "../../images/icon/edit.png";
}
.fenge {
  width: 100%;
  border-bottom: 1px #d1d1d1 solid;
  margin-bottom: 20rpx;
}
.express-address-title {
  display: flex;
  align-items: center;
}
.express-address-title title {
  margin-right: 20rpx;
  font-weight: bold;
}
.express-address-title .express-phone {
  font-size: 28rpx;
  color: #686868;
}
.detail-address {
  margin-top: 15rpx;
  font-size: 26rpx;
  color: #727272;
}